<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows on Android 12 and later. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/study_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- 40dp, the header height StudyWidgetRenderer counts with. -->
    <LinearLayout
        android:id="@+id/study_widget_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/study_widget_header"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="16sp"/>

        <ImageView
            android:id="@+id/study_widget_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/study_widget_add_background"
            android:contentDescription="@string/study_widget_add"
            android:scaleType="center"
            android:src="@drawable/study_widget_add"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/study_widget_dot"
            android:tint="#FF6366F1"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/study_widget_preview_title_1"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/study_widget_preview_time_1"
            android:textColor="@color/study_widget_on_surface_variant"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/study_widget_dot"
            android:tint="#FF14B8A6"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/study_widget_preview_title_2"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/study_widget_preview_time_2"
            android:textColor="@color/study_widget_on_surface_variant"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/study_widget_dot"
            android:tint="#FFF97316"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/study_widget_preview_title_3"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/study_widget_preview_time_3"
            android:textColor="@color/study_widget_on_surface_variant"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
