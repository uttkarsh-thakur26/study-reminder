<?xml version="1.0" encoding="utf-8"?>
<!-- The widget. Rows are 32dp each; StudyWidgetRenderer shows as many as fit
     the height, up to six, and fills them in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/study_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- 40dp, the header height StudyWidgetRenderer counts with. -->
    <LinearLayout
        android:id="@+id/study_widget_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/study_widget_header"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="16sp"/>

        <ImageView
            android:id="@+id/study_widget_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/study_widget_add_background"
            android:contentDescription="@string/study_widget_add"
            android:scaleType="center"
            android:src="@drawable/study_widget_add"/>
    </LinearLayout>

    <!-- While a focus session runs on the phone: 32dp and a 4dp gap. -->
    <LinearLayout
        android:id="@+id/study_widget_focus"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/study_widget_focus_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/study_widget_focus_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_accent_container"
            android:textSize="13sp"/>

        <Chronometer
            android:id="@+id/study_widget_focus_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:countDown="true"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_accent_container"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Up to six reminders, 32dp each. -->
    <LinearLayout
        android:id="@+id/study_widget_row_0"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/study_widget_dot_0"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/study_widget_dot"/>

        <TextView
            android:id="@+id/study_widget_title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/study_widget_time_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface_variant"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/study_widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/study_widget_dot_1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/study_widget_dot"/>

        <TextView
            android:id="@+id/study_widget_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/study_widget_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface_variant"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/study_widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/study_widget_dot_2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/study_widget_dot"/>

        <TextView
            android:id="@+id/study_widget_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/study_widget_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface_variant"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/study_widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/study_widget_dot_3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/study_widget_dot"/>

        <TextView
            android:id="@+id/study_widget_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/study_widget_time_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface_variant"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/study_widget_row_4"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/study_widget_dot_4"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/study_widget_dot"/>

        <TextView
            android:id="@+id/study_widget_title_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/study_widget_time_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface_variant"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/study_widget_row_5"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/study_widget_dot_5"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/study_widget_dot"/>

        <TextView
            android:id="@+id/study_widget_title_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/study_widget_time_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/study_widget_on_surface_variant"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/study_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/study_widget_empty_title"
            android:textColor="@color/study_widget_on_surface"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/study_widget_empty_message"
            android:textColor="@color/study_widget_on_surface_variant"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
